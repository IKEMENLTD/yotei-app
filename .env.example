# 環境変数のひな形
#
# このファイルは git にコミットする（値は書かない）。
# 使うときは .env にコピーして、値を貼り付ける。
#
#   cp .env.example .env

# --- Anthropic API（メモの要約） ---
# 秘密の鍵。server.js だけが読む。ブラウザには渡さない。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PORT=

# --- Supabase ---
# プロジェクトの URL（形式: https://<プロジェクトID>.supabase.co）
VITE_SUPABASE_URL=

# 公開用の匿名キー（anon public）
VITE_SUPABASE_ANON_KEY=
